# Workorder Agent runtime preview is disabled by default.
# Enable both preview flags below to expose the manual developer diagnostics panel.
VITE_WORKORDER_WIDGET_SHADOW_MODE_ENABLED=false
VITE_WORKORDER_WIDGET_DEV_PREVIEW_ENABLED=false
VITE_WORKORDER_AGENT_RUNTIME_PREVIEW_ENABLED=false

# Workorder Agent runtime endpoint.
# Set either the full URL, or set BASE_URL plus PATH.
# The runtime endpoint is only called by the manual preview diagnostics UI.

# Full endpoint override. Takes precedence when present.
VITE_WORKORDER_AGENT_RUNTIME_URL=

# Base URL + path mode. Leave BASE_URL empty to keep runtime fetch disabled.
VITE_WORKORDER_AGENT_RUNTIME_BASE_URL=
VITE_WORKORDER_AGENT_RUNTIME_PATH=/api/runtime/workorder-agent

# Positive integer milliseconds. Invalid, empty, zero, or negative values fall back to 10000.
VITE_WORKORDER_AGENT_RUNTIME_TIMEOUT_MS=10000
